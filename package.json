{
  "name": "eshule",
  "version": "0.3.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "npm run dev --workspace=@eshule/web-react",
    "build": "npm run build --workspace=@eshule/web-react",
    "preview": "npm run preview --workspace=@eshule/web-react",
    "typecheck": "tsc --noEmit -p apps/web-react/tsconfig.json",
    "test": "npm run test --workspace=@eshule/web-react",
    "test:watch": "npm run test:watch --workspace=@eshule/web-react",
    "test:e2e": "npm run test:e2e --workspace=@eshule/web-react",
    "test:e2e:install": "playwright install --with-deps chromium",
    "lint": "eslint apps/web-react/src scripts supabase/functions",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^3.24.0"
  },
  "overrides": {
    "nanoid": "3.3.18",
    "cookie": "0.7.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.1",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^10.8.0",
    "pg": "^8.22.0",
    "prettier": "^3.4.0",
    "prettier-plugin-tailwindcss": "^0.6.0",
    "typescript": "^5.7.0"
  }
}
